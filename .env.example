# Copy to .env to override. docker compose has working defaults for all of these.
POSTGRES_USER=shodh
POSTGRES_PASSWORD=shodh_dev_password
POSTGRES_DB=shodh
DATABASE_URL=postgresql+psycopg://shodh:shodh_dev_password@postgres:5432/shodh

# Submitted code runs in a locked-down sibling container. Recorded on every attempt.
EXEC_MODE=docker

API_WORKERS=2
JUDGE_CONCURRENCY=2
LEASE_SECONDS=30
MAX_DELIVERIES=3
DEV_AUTH_ENABLED=true
LOG_LEVEL=INFO
