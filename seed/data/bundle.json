  "problem_library": {
    "sum-two": {
      "title": "Sum of Two Integers",
      "statement": "Read two integers a and b on standard input and print a + b.",
      "time_limit_ms": 2000,
      "memory_limit_mb": 128,
      "output_limit_bytes": 8192,
      "max_points": 100,
      "compare_mode": "TRIM_TRAILING_WS",
      "suite": {
        "label": "sum-two v1",
        "cases": [
          {"ordinal": 1, "input": "2 3\n", "expected_output": "5\n", "is_sample": true, "weight": 1},
          {"ordinal": 2, "input": "-4 1\n", "expected_output": "-3\n", "is_sample": true, "weight": 1},
          {"ordinal": 3, "input": "0 0\n", "expected_output": "0\n", "is_sample": false, "weight": 1},
          {"ordinal": 4, "input": "1000000 2000000\n", "expected_output": "3000000\n", "is_sample": false, "weight": 1},
          {"ordinal": 5, "input": "-5 -5\n", "expected_output": "-10\n", "is_sample": false, "weight": 1}
        ]
      }
    },
    "max-in-list": {
      "title": "Largest Value",
      "statement": "The first line holds n. The next n integers are the list. Print the largest.",
      "time_limit_ms": 2000,
      "memory_limit_mb": 128,
      "output_limit_bytes": 8192,
      "max_points": 100,
      "compare_mode": "TRIM_TRAILING_WS",
      "suite": {
        "label": "max-in-list v1",
        "cases": [
          {"ordinal": 1, "input": "3\n1 5 2\n", "expected_output": "5\n", "is_sample": true, "weight": 1},
          {"ordinal": 2, "input": "1\n-7\n", "expected_output": "-7\n", "is_sample": false, "weight": 1},
          {"ordinal": 3, "input": "5\n9 9 1 2 3\n", "expected_output": "9\n", "is_sample": false, "weight": 1},
          {"ordinal": 4, "input": "4\n-1 -2 -3 -4\n", "expected_output": "-1\n", "is_sample": false, "weight": 1}
        ]
      }
    },
    "word-count": {
      "title": "Count the Words",
      "statement": "Print how many whitespace separated words appear on standard input.",
      "time_limit_ms": 2000,
      "memory_limit_mb": 128,
      "output_limit_bytes": 8192,
      "max_points": 100,
      "compare_mode": "TRIM_TRAILING_WS",
      "suite": {
        "label": "word-count v1",
        "cases": [
          {"ordinal": 1, "input": "hello world\n", "expected_output": "2\n", "is_sample": true, "weight": 1},
          {"ordinal": 2, "input": "one\n", "expected_output": "1\n", "is_sample": false, "weight": 1},
          {"ordinal": 3, "input": "a b c d e\n", "expected_output": "5\n", "is_sample": false, "weight": 1}
        ]
      }
    }
  },
